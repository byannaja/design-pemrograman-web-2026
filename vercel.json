{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/jobsheet-08/assets/(.*)",
      "dest": "/jobsheet-08/assets/$1"
    },
    {
      "src": "/jobsheet-08/barang/list.php",
      "dest": "/api/barang-list.php"
    },
    {
      "src": "/jobsheet-08/barang/tambah.php",
      "dest": "/api/barang-tambah.php"
    },
    {
      "src": "/jobsheet-08/barang/edit.php",
      "dest": "/api/barang-edit.php"
    },
    {
      "src": "/jobsheet-08/barang/hapus.php",
      "dest": "/api/barang-hapus.php"
    },
    {
      "src": "/jobsheet-08/index.php",
      "dest": "/api/index.php"
    },

    {
      "src": "/jobsheet-09/assets/(.*)",
      "dest": "/jobsheet-09/assets/$1"
    },
    {
      "src": "/jobsheet-09/barang/list.php",
      "dest": "/api/jobsheet09.php?__target=barang-list"
    },
    {
      "src": "/jobsheet-09/barang/tambah.php",
      "dest": "/api/jobsheet09.php?__target=barang-tambah"
    },
    {
      "src": "/jobsheet-09/barang/edit.php",
      "dest": "/api/jobsheet09.php?__target=barang-edit"
    },
    {
      "src": "/jobsheet-09/barang/proses_edit.php",
      "dest": "/api/jobsheet09.php?__target=barang-proses-edit"
    },
    {
      "src": "/jobsheet-09/barang/hapus.php",
      "dest": "/api/jobsheet09.php?__target=barang-hapus"
    },
    {
      "src": "/jobsheet-09/supplier/list.php",
      "dest": "/api/jobsheet09.php?__target=supplier-list"
    },
    {
      "src": "/jobsheet-09/supplier/tambah.php",
      "dest": "/api/jobsheet09.php?__target=supplier-tambah"
    },
    {
      "src": "/jobsheet-09/supplier/edit.php",
      "dest": "/api/jobsheet09.php?__target=supplier-edit"
    },
    {
      "src": "/jobsheet-09/supplier/proses_edit.php",
      "dest": "/api/jobsheet09.php?__target=supplier-proses-edit"
    },
    {
      "src": "/jobsheet-09/supplier/hapus.php",
      "dest": "/api/jobsheet09.php?__target=supplier-hapus"
    },
    {
      "src": "/jobsheet-09/index.php",
      "dest": "/api/jobsheet09.php?__target=index"
    },

    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}